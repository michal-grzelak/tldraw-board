{
  "name": "tldraw",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ardentcode/tldraw"
  },
  "license": "MIT",
  "author": "Michał Grzelak",
  "type": "module",
  "scripts": {
    "build": "NODE_ENV=production run-s 'build:react' 'build:server' 'build:ext'",
    "build:ext": "ts-add-js-extension --dir build/server",
    "build:react": "react-router build",
    "build:server": "tsc --project tsconfig.server.json",
    "check": "run-p 'check:*'",
    "check:eslint": "eslint .",
    "check:format": "prettier --check .",
    "check:type": "run-s typegen 'build:server --noEmit' 'tsc --noEmit'",
    "dev": "tsx watch ./server/start",
    "format": "prettier --write .",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --env-file-if-exists=.env.production ./build/server/start.js",
    "tsc": "tsc",
    "typegen": "react-router typegen",
    "prepare": "husky"
  },
  "dependencies": {
    "@mcansh/remix-fastify": "^4.0.6",
    "@react-router/node": "^7.2.0",
    "@react-router/serve": "^7.2.0",
    "@tanstack/react-query": "^5.66.9",
    "fastify": "^5.2.1",
    "get-port": "^7.1.0",
    "globals": "^16.0.0",
    "isbot": "^5.1.23",
    "pino": "^9.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@react-router/dev": "^7.2.0",
    "@tailwindcss/vite": "^4.0.8",
    "@tanstack/eslint-plugin-query": "^5.66.1",
    "@tanstack/react-query-devtools": "^5.66.9",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.21.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "canary",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "npm-run-all2": "^7.0.2",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.8",
    "ts-add-js-extension": "^1.6.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.1.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.6"
  },
  "engines": {
    "node": ">=22"
  }
}
