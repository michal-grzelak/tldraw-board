{
  "include": [
    "./app/**/*.ts",
    "./app/**/*.tsx",
    "./app/**/.server/**/*.ts",
    "./app/**/.server/**/*.tsx",
    "./app/**/.client/**/*.ts",
    "./app/**/.client/**/*.tsx",
    ".react-router/types/**/*"
  ],
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "module": "ES2022",
    "target": "ES2022",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noImplicitOverride": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["@react-router/node", "vite/client", "./types/environment.d.ts"],
    "verbatimModuleSyntax": true,
    "paths": {
      "@routes/*": ["./app/routes/*"],
      "@components/*": ["./app/components/*"],
      "@util/*": ["./app/util/*"],
      "@client/*": ["./app/*"],
      "@server/*": ["./server/*"],
      "@t/*": ["./types/*"]
    },
    "noEmit": true,
    "rootDirs": [".", "./.react-router/types"],
    "plugins": [{ "name": "@react-router/dev" }]
  }
}
